# ANA Meet — environment template. Copy to .env and fill in real values. Never commit .env.
# Used by docker-compose.yml and server/ (server also has its own .env.example).

# --- Infrastructure (docker-compose) ---
POSTGRES_USER=anameet
POSTGRES_PASSWORD=change_me_dev_only
POSTGRES_DB=anameet
POSTGRES_PORT=5432
REDIS_PORT=6379

# --- Server ---
PORT=4000
NODE_ENV=development
# Comma-separated trusted origins for CORS + credentialed requests (no "*")
CLIENT_ORIGIN=http://localhost:3000
PUBLIC_ORIGIN=http://localhost:4000
TRUST_PROXY_HOPS=0

# Sequelize will use this when set; otherwise it is built from POSTGRES_* above.
# Example: postgres://anameet:change_me_dev_only@localhost:5432/anameet
DATABASE_URL=
DB_POOL_MAX=10
DB_POOL_MIN=0
DB_POOL_IDLE_MS=10000
DB_POOL_ACQUIRE_MS=30000

REDIS_URL=redis://localhost:6379

# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=change_me_access_secret_min_32_chars
JWT_REFRESH_SECRET=change_me_refresh_secret_min_32_chars_different
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

COOKIE_DOMAIN=
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Rate limits (requests per window). Consumed per-IP; Redis-backed when REDIS_URL is set.
RATE_LIMIT_AUTH_WINDOW_MS=900000
RATE_LIMIT_AUTH_MAX=50
RATE_LIMIT_API_WINDOW_MS=60000
RATE_LIMIT_API_MAX=300
RATE_LIMIT_UPLOAD_WINDOW_MS=3600000
RATE_LIMIT_UPLOAD_MAX=60

# Local storage root for uploads (absolute path in production).
UPLOAD_DIR=./uploads

LOG_LEVEL=info

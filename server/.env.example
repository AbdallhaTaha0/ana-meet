# ANA Meet server — copy to .env for local development. Never commit .env.
PORT=4000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:3000
PUBLIC_ORIGIN=http://localhost:4000
TRUST_PROXY_HOPS=0

POSTGRES_USER=anameet
POSTGRES_PASSWORD=change_me_dev_only
POSTGRES_DB=anameet
DATABASE_URL=
DB_POOL_MAX=10
DB_POOL_MIN=0
DB_POOL_IDLE_MS=10000
DB_POOL_ACQUIRE_MS=30000
# Run pending migrations automatically on boot (development convenience only).
DB_AUTO_MIGRATE=true

REDIS_URL=redis://localhost:6379

JWT_ACCESS_SECRET=change_me_access_secret_min_32_chars
JWT_REFRESH_SECRET=change_me_refresh_secret_min_32_chars_different
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

COOKIE_DOMAIN=
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

RATE_LIMIT_AUTH_WINDOW_MS=900000
RATE_LIMIT_AUTH_MAX=50
RATE_LIMIT_API_WINDOW_MS=60000
RATE_LIMIT_API_MAX=300
RATE_LIMIT_UPLOAD_WINDOW_MS=3600000
RATE_LIMIT_UPLOAD_MAX=60

# Local storage root (absolute path in production). Object storage can
# replace the backend behind src/storage without caller changes.
UPLOAD_DIR=./uploads

# Dedicated database used by integration tests (must exist before `npm test`).
TEST_DATABASE_URL=postgres://anameet:change_me_dev_only@localhost:5432/anameet_test

LOG_LEVEL=info
